{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okeconnect-ops",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/telegram/webhook", "/okeconnect/callback", "/health"] },
  "d1_databases": [{ "binding": "DB", "database_name": "okeconnect-db", "database_id": "6c78fe4c-c255-46a2-ae37-4990aad4b8e7" }],
  "vars": { "DEFAULT_MARKUP": "1000" }
}
